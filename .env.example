# MinIO Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=chitra-photos

# Database Configuration
CHITRA_DB_PATH=./chitra.db

# Redis Configuration (for RQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0


# JWT signing secret (required in production; generate with: openssl rand -hex 32)
JWT_SECRET_KEY=

# ML thread count for the RQ workers. thread_limits.sh applies this to
# OMP/MKL/OPENBLAS/NUMEXPR at launch. 3 is the measured optimum for CLIP on a
# 6-core box (77 ms/image embed, vs 151 ms at the 6-thread default). The API is
# hard-capped at 2 and does not read this.
# CHITRA_ML_THREADS=3

# Setting any of OMP_NUM_THREADS / MKL_NUM_THREADS / OPENBLAS_NUM_THREADS /
# NUMEXPR_NUM_THREADS here overrides the launcher defaults for that variable —
# thread_limits.sh is sourced after this file and only fills in what is unset.
# Note: onnxruntime ignores all of these; it sizes its own pool to core count.

# ---------------------------------------------------------------------------
# CLIP embedding sidecar (embed_service.py)
# ---------------------------------------------------------------------------
# The API holds no ML model: text embeddings for search come from one
# long-lived sidecar over loopback. If it is down, search returns 503 — there
# is deliberately no in-process fallback, because one would quietly re-create
# the OOM that this split exists to fix.

# Where the API looks for the sidecar.
# CHITRA_EMBED_URL=http://127.0.0.1:5101
# CHITRA_EMBED_TIMEOUT=5.0
# Optional shared secret. Set it in both the API's and the sidecar's env.
# CHITRA_EMBED_TOKEN=

# start_workers.sh launches the sidecar itself (1 = default). Set to 0 once
# chitra-embed.service exists, so systemd owns it and a worker restart stops
# taking search down with it.
# CHITRA_EMBED_SELF_START=1
# CHITRA_EMBED_HOST=127.0.0.1
# CHITRA_EMBED_PORT=5101

# ---------------------------------------------------------------------------
# In-process thumbnail cache (core/cache.py)
# ---------------------------------------------------------------------------
# Bounded by BYTES, per uvicorn worker — multiply by WORKERS for the tier's
# ceiling. The default 64 MiB x 4 workers = 256 MiB. It used to be bounded only
# at 1,000 entries, and since ensure_thumb writes 150-400 KB JPEGs that allowed
# ~250 MB per worker; on 2026-09-01 the four workers reached 959/908/805/839 MB
# against a 4 GB MemoryMax. Set to 0 to disable caching entirely.
# CHITRA_THUMB_CACHE_BYTES=67108864

# Secondary bound, so a flood of tiny objects cannot cost unbounded dict
# overhead while sitting well inside the byte budget.
# CHITRA_THUMB_CACHE_ENTRIES=1000
